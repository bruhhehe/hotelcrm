# ─────────────────────────────────────────────────────────────────────────────
# Lodgely environment. Copy to .env.local for local dev.
# Every integration is optional: when a key is missing the UI shows a
# "Connect X in Settings" state instead of crashing. Validated in lib/env/schema.ts.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. On Vercel: Storage → Neon (use the pooled "-pooler" URL).
# Local: postgresql://postgres@localhost:5432/lodgely
DATABASE_URL=

# Auth.js — generate with `npx auth secret` (≥ 32 chars). Required in production.
AUTH_SECRET=
# Google OAuth (staff sign-in). Callback: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe — guest deposits/balances (Connect Standard) + Lodgely's own SaaS billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Resend — transactional email. Without it, dev prints magic links to the console.
RESEND_API_KEY=
# e.g. EMAIL_FROM="Lodgely <hello@yourdomain.com>" (set together with RESEND_API_KEY)
EMAIL_FROM=

# Twilio — SMS reminders (all three or none).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Vercel Blob — documents, room photos, ID scans.
BLOB_READ_WRITE_TOKEN=

# Google Places — address autocomplete (browser key; restrict by HTTP referrer).
NEXT_PUBLIC_GOOGLE_PLACES_KEY=

# Google Calendar — per-staff one-way sync.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Vercel Cron — sent as `Authorization: Bearer $CRON_SECRET` (≥ 16 chars).
CRON_SECRET=

# Public base URL (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
